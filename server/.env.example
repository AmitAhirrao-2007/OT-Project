# =============================================================================
# EV ROUTE PLANNER — SERVER-SIDE CONFIGURATION TEMPLATE
# Placeholders only. NEVER commit real credentials or expose secrets in VITE_ vars.
# =============================================================================

# Server Daemon Port & Environment
PORT=3001
NODE_ENV=development

# Upstream OCPI 2.2.1 / 2.3.0 CPO Credentials (Requires formal B2B partner agreement)
# Kept strictly server-side; NEVER sent to browser client.
OCPI_CPO_BASE_URL=https://cpo-sandbox.example.com/ocpi/2.2.1
OCPI_SERVER_TOKEN=ocpi_server_token_placeholder_never_share
OCPI_CLIENT_PARTY_ID=EVR
OCPI_CLIENT_COUNTRY_CODE=IN

# Request Timeout and Sync Interval
OCPI_REQUEST_TIMEOUT_MS=6000
OCPI_MAX_RETRIES=2
OCPI_SYNC_INTERVAL_MINUTES=15

# Open Data Aggregators (Optional Static Corroboration)
OPEN_CHARGE_MAP_API_KEY=ocm_api_key_placeholder

# TomTom Orbis Places, Routing & Real-Time Traffic API
# Developer Portal: https://developer.tomtom.com
# Provides Places search suggestions, real-time traffic flow tiles, incident feeds, and traffic-aware routing.
TOMTOM_API_KEY=your_tomtom_api_key_here
VITE_TOMTOM_API_KEY=your_tomtom_api_key_here

